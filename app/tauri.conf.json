{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SundayPudding",
  "version": "0.0.1",
  "identifier": "com.sundaypudding.roguelike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/?core=rust&full=1",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SundayPudding (Rust 코어 검증)",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
